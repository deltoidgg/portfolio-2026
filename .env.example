# Neon serverless Postgres connection string (server only; never prefix with VITE_)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Transitional app delivery switch. Production removes DATABASE_URL after R2 promotion.
VITE_MI_DATA_SOURCE=r2
VITE_MI_PUBLIC_ARTIFACT_BASE_URL=https://data.fpl.wasimarif.com/serving/v1/next

# Current season. The collector imports the official 380-fixture schedule before FPL launches.
MI_SEASON_KEY=epl:2026-27
MI_SEASON=2026/27
MI_SEASON_STARTS_AT=2026-08-21T00:00:00.000Z
MI_SEASON_ENDS_AT=2027-05-30T23:59:59.000Z
MI_RULESET_KEY=fpl:2026-27:official-v1
MI_FIXTURES_URL=https://www.premierleague.com/en/news/4675097/all-380-fixtures-for-202627-premier-league-season/

# Point-in-time capture and model jobs. Gameweek/deadline are optional manual overrides.
MI_GAMEWEEK=
MI_DEADLINE_AT=
MI_MODEL_INPUT=./data/inputs/market-intelligence/baseline-model.example.json
MI_MARKET_XP_INPUT=
MI_FORECAST_HORIZONS=1,3,5
MI_ODDS_MARKETS=h2h,totals
MI_COLLECTION_ENABLED=false
MI_ARTIFACT_CHANNEL=next
THE_ODDS_API_KEY=

# Cloudflare R2 hot/cold stores (Actions only; never expose these to Vite/client code)
CLOUDFLARE_ACCOUNT_ID=
R2_ENDPOINT=
R2_PRIVATE_BUCKET=fpl-market-intelligence-raw
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=fpl-market-intelligence-public
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=

# Protected migration/cutover tasks only. Never expose direct owner URLs to Vercel or the
# scheduled collector. Use one fixed ISO MI_CUTOVER_AT for an export and every consuming task.
LEGACY_DATABASE_DIRECT_URL=
NEXT_DATABASE_MIGRATION_URL=
PRODUCTION_DATABASE_MIGRATION_URL=
DATABASE_MIGRATION_URL=
COLLECTOR_ROLE_PASSWORD=
MI_CUTOVER_AT=
MI_IMPORT_MANIFEST_KEY=
MI_RESTORE_DATABASE_URL=
MI_ROLLBACK_RECORD_KEY=
